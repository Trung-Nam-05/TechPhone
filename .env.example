# GHN — DEV only (KHONG dung production khi dev)
GHN_ENABLED=true
GHN_API_TOKEN=your_ghn_dev_token
GHN_SHOP_ID=1234567
GHN_API_URL=https://dev-online-gateway.ghn.vn
GHN_POLL_ENABLED=false
# Tu dong chuyen trang thai don tren TechPhone sau khi admin tao van don (staging, khong shipper that)
GHN_DEMO_PROGRESS_ENABLED=true
GHN_DEMO_PROGRESS_MS=5000
GHN_DEMO_AWAIT_TO_PICKED_MS=30000
GHN_DEMO_PICKED_TO_SHIPPING_MS=30000
GHN_DEMO_SHIPPING_TO_COMPLETE_MS=30000
GHN_RETRY_MS=300000

# Socket.io chat
SOCKET_CORS_ORIGIN=http://localhost:5173
VITE_SOCKET_URL=http://localhost:4000

# Gemini AI chatbox
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
AI_CHAT_RATE_LIMIT=20
AI_CHAT_HTTP_RATE_LIMIT=60

# SMTP — email xác minh liên kết + quên mật khẩu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=TechPhone <your_email@gmail.com>

# Public API URL (dùng trong link xác minh email)
API_PUBLIC_URL=http://localhost:4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change_me_in_production
