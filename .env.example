# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/techphone

# JWT — đổi chuỗi dài trên Render (khác local)
JWT_SECRET=change_me_in_production

# Local dev: tách FE (5173) + API (4000)
CLIENT_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000
SOCKET_CORS_ORIGIN=http://localhost:5173
VITE_SOCKET_URL=http://localhost:4000
ALLOW_LOCALHOST_ORIGINS=true

# Docker / Render all-in-one: cùng một URL (vd https://techphone-xxxx.onrender.com)
# CLIENT_ORIGIN=https://techphone-xxxx.onrender.com
# API_PUBLIC_URL=https://techphone-xxxx.onrender.com
# SOCKET_CORS_ORIGIN=https://techphone-xxxx.onrender.com
# ALLOW_LOCALHOST_ORIGINS=false
# SERVE_STATIC=true
# NODE_ENV=production
# (Không cần VITE_* — Dockerfile build same-origin)

PORT=4000
SERVE_STATIC=false

# Admin seed (npm run seed)
ADMIN_EMAIL=admin@techphone.local
ADMIN_PASSWORD=Admin@123456

# GHN — DEV only (KHONG dung production khi dev)
GHN_ENABLED=true
GHN_API_TOKEN=your_ghn_dev_token
GHN_SHOP_ID=1234567
GHN_API_URL=https://dev-online-gateway.ghn.vn
GHN_POLL_ENABLED=false
GHN_DEMO_PROGRESS_ENABLED=true
GHN_DEMO_PROGRESS_MS=5000
GHN_DEMO_AWAIT_TO_PICKED_MS=30000
GHN_DEMO_PICKED_TO_SHIPPING_MS=30000
GHN_DEMO_SHIPPING_TO_COMPLETE_MS=30000
GHN_RETRY_MS=300000

# Demo fulfillment (khi GHN_ENABLED=false)
FULFILLMENT_DEMO_ENABLED=false

# VNPAY Sandbox
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Gemini AI chatbox
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
AI_CHAT_RATE_LIMIT=20
AI_CHAT_HTTP_RATE_LIMIT=60

# SMTP — email xác minh liên kết + quên mật khẩu + marketing
# Render: thêm cùng block này trong Environment (App Password Gmail, bỏ khoảng trắng trong pass)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=TechPhone <your_email@gmail.com>
